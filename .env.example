JWT_SECRET=replace-with-a-secure-random-value-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/codealpha_faq_db

QDRANT_URL=https://your-qdrant-cloud-cluster
QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION_NAME=codealpha_faq_knowledge_base

GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=3072

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.50

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_API_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=/api
